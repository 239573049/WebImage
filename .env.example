# ============================================
# ChatGPT2API 环境变量配置示例（配合 docker-compose.yml 使用）
#   cp .env.example .env
#   docker compose up -d --build
# ============================================

# 认证密钥（必填，调用 /v1/* 时的 Bearer token）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# Sentinel 求解服务（必填，网页 turnstile 挑战需要）
# 当前网页的 turnstile 已改为随机化 opcode 的 VM，纯 Python 复刻无法跟上，
# 需要 docker-compose.yml 里的常驻 Chromium 求解服务 sentinel-solver。
# 主服务与 solver 共用同一个密钥，随便取一个长随机串即可。
# ============================================

SENTINEL_SOLVER_KEY=change_me_to_a_long_random_string

# solver 里浏览器自身的出网代理（留空直连）。可填 http://host:port，也可带认证 http://user:pass@host:port；
# 建议与主服务的上游代理填同一个（住宅代理的粘性会话串也原样照抄），两边走同一出口 IP
# SENTINEL_SOLVER_PROXY=

# solver 镜像（默认拉取 CI 推送的镜像；本地改了 solver 代码时用 --build 重新构建）
# SENTINEL_SOLVER_IMAGE=ghcr.io/239573049/webimage-sentinel-solver:latest

# ============================================
# Sentinel 求解服务的接入参数（一般无需修改；
# 仅当 config.json 里还没有 sentinel_solver 时生效，之后以 config.json 为准）
# ============================================

# CHATGPT2API_SENTINEL_SOLVER_ENABLED=true
# CHATGPT2API_SENTINEL_SOLVER_URL=http://sentinel-solver:8788
# CHATGPT2API_SENTINEL_SOLVER_KEY=与上面的 SENTINEL_SOLVER_KEY 一致
# CHATGPT2API_SENTINEL_SOLVER_TIMEOUT_SECONDS=180

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: sqlite（数据存放在 data/accounts.db，首次启动会自动迁移旧的 data/accounts.json）
STORAGE_BACKEND=sqlite

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# 注意：容器内 config.json 已存在时不会被环境变量覆盖，上面这些配置首次启动写入一次
# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db，通常无需设置）
# 注意：绝对路径需要 4 个斜杠（sqlite:// + /app/...）
# DATABASE_URL=sqlite:////app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json

# ============================================
# 上游出口代理（可选，直连不稳时用）
# 接管上游 OpenAI / ChatGPT 请求，避免 Cloudflare 拦截：
#   CHATGPT2API_PROXY_RUNTIME_PROXY_URL 填 http://host:port（宿主机上的 WARP / Privoxy / 其他 HTTP 代理）
# 也可以在后台设置页的「稳定代理运行时」面板里配置和测试。
# ============================================

# CHATGPT2API_PROXY_RUNTIME_ENABLED=false
# CHATGPT2API_PROXY_RUNTIME_EGRESS_MODE=single_proxy
# CHATGPT2API_PROXY_RUNTIME_PROXY_URL=
# CHATGPT2API_PROXY_RUNTIME_SKIP_SSL_VERIFY=false

# ============================================
# 可选：mihomo 代理内核（代理池导入订阅里的 ss / vmess / trojan 等节点时用）
# HTTP / SOCKS5 节点不需要它。启用后执行：docker compose --profile proxy-core up -d
# ============================================

# CHATGPT2API_PROXY_CORE_ENABLED=true
# 内核控制接口的密钥，主服务与内核共用，随便取一个长随机串
# PROXY_CORE_SECRET=change_me_too
# PROXY_CORE_IMAGE=metacubex/mihomo:v1.19.20

# ============================================
# Means 对象存储（可选：图片返回直链时用）
# 默认 compose 不含 Means，用法见 docs/means-image-storage.md
# 仅当 config.json 中尚无 means 配置时生效；
# 初始化后会写入 config.json，之后以 config.json / 管理界面为准
# ============================================

# Means 控制台账号密码（Means 检测到默认值会拒绝以生产模式启动，必须替换）
# MEANS_CONSOLE_ADMIN_USER=meansadmin
# MEANS_CONSOLE_ADMIN_PASSWORD=your_console_password

# S3 数据面密钥，必须与下面的 CHATGPT2API_MEANS_ACCESS_KEY / SECRET_KEY 一致
# CHATGPT2API_MEANS_ACCESS_KEY=meansadmin
# CHATGPT2API_MEANS_SECRET_KEY=your_means_secret

# CHATGPT2API_MEANS_ENABLED=true
# Means 独立部署在宿主机上时用 http://127.0.0.1:5178/s3/；同一个 compose 内用 http://means:8080/s3/
# CHATGPT2API_MEANS_ENDPOINT=http://127.0.0.1:5178/s3/
# CHATGPT2API_MEANS_BUCKET=generated-images
# CHATGPT2API_MEANS_PREFIX=chatgpt2api/images
# 客户端访问图片的地址，需包含 bucket 路径；留空则返回容器内地址
# CHATGPT2API_MEANS_PUBLIC_BASE_URL=https://files.example.com/generated-images
# CHATGPT2API_MEANS_REGION=us-east-1
# CHATGPT2API_MEANS_SERVICE=s3
# CHATGPT2API_MEANS_TIMEOUT_SECONDS=60
# CHATGPT2API_MEANS_VERIFY_SSL=true
